#!/bin/bash

GREEN='\033[0;32m'
NO_COLOR='\033[0m'

echo "*********************************************************"
echo "Running git pre-push hook."
echo "*********************************************************"
echo ""
echo "Java Version: "
echo "$JAVA_HOME"
java -version
echo "Running test... "

# The same checks as CI's build job. The Apple tests need a Mac; CI's test-apple job runs them.
# JS and Wasm run here in Node.js only; CI also runs them in headless Chrome.
./gradlew spotlessCheck :crypto:checkKotlinAbi :crypto:jvmTest :crypto:testAndroidHostTest :crypto:linuxX64Test :crypto:jsNodeTest :crypto:wasmJsNodeTest :crypto:compileAppleMainKotlinMetadata :benchmark:jvmTest :benchmark:jsNodeTest

status=$?

if [ "$status" = 0 ] ; then
    echo "All test passed."
    exit 0
else
    echo "*********************************************************"
    echo 1>&2 "Formatting or tests failed"
    printf "Run ${GREEN}./gradlew spotlessApply :crypto:checkKotlinAbi :crypto:jvmTest :crypto:testAndroidHostTest :crypto:linuxX64Test${NO_COLOR}\n"
    printf "and ${GREEN}./gradlew :crypto:jsNodeTest :crypto:wasmJsNodeTest${NO_COLOR},\n"
    printf "and ${GREEN}./gradlew :crypto:compileAppleMainKotlinMetadata${NO_COLOR}, and fix what fails before pushing...\n"
    echo "*********************************************************"
    exit 1
fi
